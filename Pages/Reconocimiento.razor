@page "/reconocimiento"
@using EtiquetadoAuto.Models
@using EtiquetadoAuto.Services
@using Microsoft.Maui.Media
@using Microsoft.JSInterop
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@inject DatabaseService DB
@inject PdfService GeneradorPdf

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0"><i class="oi oi-camera"></i> Escaneo de Albarán</h4>
        </div>
        <div class="card-body text-center">
            <p class="text-secondary">Tome la foto con cualquier inclinación. El sistema proyecta las líneas de lectura de forma dinámica.</p>
            
            @if (isProcessing)
            {
                <div class="my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 fw-bold text-primary">@estadoMensaje</p>
                </div>
            }
            else
            {
                <button class="btn btn-success btn-lg w-100 py-3 shadow-sm mb-4" @onclick="CapturarAlbaran">
                    <i class="oi oi-camera"></i> ESCANEAR AHORA
                </button>
            }

            @if (productosDetectados.Any())
            {
                <div class="text-start">
                    <h5 class="mb-3">Material Identificado (@productosDetectados.Count):</h5>
                    <div class="list-group shadow-sm mb-4">
                        @foreach (var prod in productosDetectados)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="d-block fw-bold">@prod.Nombre</span>
                                    <small class="text-muted">Ref: @prod.Codigo</small>
                                </div>
                                <span class="badge bg-primary rounded-pill px-3 py-2">Cant: @prod.Cantidad</span>
                            </div>
                        }
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg shadow" @onclick="ProcesarTodo">
                            <i class="oi oi-check"></i> CONFIRMAR E IMPRIMIR
                        </button>
                        <button class="btn btn-light btn-sm text-danger" @onclick="LimpiarEscaneo">
                            Borrar todo y repetir
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Contenedor geométrico para proyecciones lineales precisas
    public class RawLine 
    {
        public string Texto { get; set; } = "";
        public int Top { get; set; }
        public int Bottom { get; set; }
        public int Left { get; set; }
        public int Right { get; set; }
        public int Height => Bottom - Top;
        public double CenterX => (Left + Right) / 2.0;
        public double CenterY => (Top + Bottom) / 2.0;
        public bool Procesado { get; set; } = false;
        
        // Datos vectoriales de inclinación propia de la línea
        public double X0 { get; set; }
        public double Y0 { get; set; }
        public double Slope { get; set; }
        public bool TieneTrayectoria { get; set; } = false;
    }

    public class ProductoEnConstruccion
    {
        public int Cantidad { get; set; }
        public string Nombre { get; set; } = "";
        public RawLine LinePadre { get; set; }
    }

    private List<Producto> productosDetectados = new();
    private bool isProcessing = false;
    private string estadoMensaje = "";

    private async Task CapturarAlbaran()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Iniciando cámara...";
            StateHasChanged(); 

            var photo = await MediaPicker.CapturePhotoAsync();
            if (photo == null) return;

            estadoMensaje = "Analizando estructura del documento...";
            StateHasChanged(); 

            #if ANDROID
            var javaFile = new Java.IO.File(photo.FullPath);
            var imageUri = Android.Net.Uri.FromFile(javaFile);
            var image = Xamarin.Google.MLKit.Vision.Common.InputImage.FromFilePath(Android.App.Application.Context, imageUri);
            
            var options = Xamarin.Google.MLKit.Vision.Text.Latin.TextRecognizerOptions.DefaultOptions;
            var recognizer = Xamarin.Google.MLKit.Vision.Text.TextRecognition.GetClient(options);
            
            var tcs = new TaskCompletionSource<object>();
            recognizer.Process(image)
                .AddOnSuccessListener(new OnSuccessImplementation(tcs))
                .AddOnFailureListener(new OnFailureImplementation(tcs));

            var resultObj = await tcs.Task;
            var visionText = (Xamarin.Google.MLKit.Vision.Text.Text)resultObj;
            
            ProcesarTextoTrayectoria(visionText);
            #else
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidad disponible en Android.");
            #endif
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    #if ANDROID
    private void ProcesarTextoTrayectoria(Xamarin.Google.MLKit.Vision.Text.Text visionText)
    {
        productosDetectados.Clear();
        var todasLasLineas = new List<RawLine>();

        // 1. FILTRADO ULTRA-ESTRICTO DE NÚMEROS DE SERIE Y CABECERAS
        foreach (var block in visionText.TextBlocks)
        {
            foreach (var line in block.Lines)
            {
                string txt = line.Text.Trim();
                if (string.IsNullOrEmpty(txt)) continue;

                string minus = txt.ToLower()
                    .Replace("à", "a").Replace("á", "a").Replace("è", "e").Replace("é", "e")
                    .Replace("í", "i").Replace("ò", "o").Replace("ó", "o").Replace("ú", "u");

                // Filtro optimizado para eliminar ruidos de series, páginas y datos de control
                if (minus.Contains("albara") || minus.Contains("seditesa") || minus.Contains("sintesis") ||
                    minus.Contains("www") || minus.Contains("@") || minus.Contains(".com") || minus.Contains(".org") ||
                    minus.Contains("izan") || minus.Contains("lecina") || minus.Contains("carrer") || minus.Contains("carer") ||
                    minus.Contains("telf") || minus.Contains("telefon") || minus.Contains("fecha") || minus.Contains("data") ||
                    minus.Contains("quantitat") || minus.Contains("descripci") || minus.Contains("nro") || minus.Contains("comanda") ||
                    minus.Contains("pag.") || minus.Contains("pagina") || minus.Contains("cliente") || minus.Contains("proveedor") ||
                    minus.Contains("nº de serie") || minus.Contains("no. de serie") || minus.Contains("num. serie") ||
                    minus.Contains("nºserie") || minus.Contains("sn:") || minus.Contains("s/n") || minus.Contains("lote:") ||
                    minus.Contains("bulto"))
                {
                    continue;
                }

                var box = line.BoundingBox;
                if (box == null) continue;

                var corners = line.GetCornerPoints();
                double x0 = box.Left;
                double y0 = box.Top;
                double slope = 0;
                bool tieneTrayectoria = false;

                // Extraemos el vector exacto de inclinación que genera la propia línea de texto
                if (corners != null && corners.Length >= 2)
                {
                    double dx = corners[1].X - corners[0].X;
                    double dy = corners[1].Y - corners[0].Y;
                    if (Math.Abs(dx) > 10)
                    {
                        x0 = corners[0].X;
                        y0 = corners[0].Y;
                        slope = dy / dx;
                        tieneTrayectoria = true;
                    }
                }

                todasLasLineas.Add(new RawLine {
                    Texto = txt,
                    Top = box.Top,
                    Bottom = box.Bottom,
                    Left = box.Left,
                    Right = box.Right,
                    X0 = x0,
                    Y0 = y0,
                    Slope = slope,
                    TieneTrayectoria = tieneTrayectoria
                });
            }
        }

        if (!todasLasLineas.Any()) return;

        var lineasCombinadas = new List<RawLine>();
        var lineasCantidadSolo = new List<RawLine>();
        var lineasTextoSolo = new List<RawLine>();

        // 2. CLASIFICACIÓN TÉCNICA DE COMPONENTES
        foreach (var line in todasLasLineas)
        {
            string txt = line.Texto;
            var mSoloNum = System.Text.RegularExpressions.Regex.Match(txt, @"^\d{1,3}$"); // Cantidades cortas puras
            var mIzq = System.Text.RegularExpressions.Regex.Match(txt, @"^(\d{1,3})\s+(.+)$");
            var mDer = System.Text.RegularExpressions.Regex.Match(txt, @"^(.+)\s+(\d{1,3})$");

            if (mSoloNum.Success)
            {
                lineasCantidadSolo.Add(line);
            }
            else if (mIzq.Success || mDer.Success)
            {
                lineasCombinadas.Add(line);
            }
            else
            {
                // Entran descripciones y números de artículo puros sin importar si tienen letras o no
                lineasTextoSolo.Add(line);
            }
        }

        var listaEnConstruccion = new List<ProductoEnConstruccion>();

        // 3. PROCESAR LÍNEAS COMBINADAS DE FORMA NATIVA
        foreach (var line in lineasCombinadas)
        {
            string txt = line.Texto;
            var mIzq = System.Text.RegularExpressions.Regex.Match(txt, @"^(\d{1,3})\s+(.+)$");
            var mDer = System.Text.RegularExpressions.Regex.Match(txt, @"^(.+)\s+(\d{1,3})$");

            int cant = 1;
            string nombre = txt;

            if (mIzq.Success)
            {
                cant = int.Parse(mIzq.Groups[1].Value);
                nombre = mIzq.Groups[2].Value;
            }
            else if (mDer.Success)
            {
                cant = int.Parse(mDer.Groups[2].Value);
                nombre = mDer.Groups[1].Value;
            }

            listaEnConstruccion.Add(new ProductoEnConstruccion {
                Cantidad = cant,
                Nombre = nombre,
                LinePadre = line
            });
        }

        // 4. ACOPLAR CANTIDADES SUELTAS CON SU TRAYECTORIA CORRESPONDIENTE
        foreach (var qLine in lineasCantidadSolo)
        {
            RawLine mejorMatchTexto = null;
            double minDesviacion = double.MaxValue;

            foreach (var tLine in lineasTextoSolo.Where(t => !t.Procesado))
            {
                double dev = CalcularDesviacionRenglon(tLine, qLine.CenterX, qLine.CenterY);
                
                // Tolerancia dinámica auto-escalable: 1.5 veces el alto real de la tipografía
                if (dev < (tLine.Height * 1.5) && dev < minDesviacion)
                {
                    minDesviacion = dev;
                    mejorMatchTexto = tLine;
                }
            }

            if (mejorMatchTexto != null)
            {
                mejorMatchTexto.Procesado = true;
                int.TryParse(qLine.Texto, out int cant);

                listaEnConstruccion.Add(new ProductoEnConstruccion {
                    Cantidad = cant,
                    Nombre = mejorMatchTexto.Texto,
                    LinePadre = mejorMatchTexto
                });
            }
        }

        // 5. UNIFICACIÓN DE LÍNEAS ROTAS (ORFANAS) MEDIANTE PARALELISMO VERTICAL
        var huerfanas = lineasTextoSolo.Where(t => !t.Procesado).OrderBy(t => t.CenterY).ToList();
        foreach (var hLine in huerfanas)
        {
            ProductoEnConstruccion prodPadre = null;
            double minDeviacionContinuacion = double.MaxValue;

            foreach (var prod in listaEnConstruccion)
            {
                double yEsperado = prod.LinePadre.TieneTrayectoria 
                    ? prod.LinePadre.Y0 + prod.LinePadre.Slope * (hLine.CenterX - prod.LinePadre.X0)
                    : prod.LinePadre.CenterY;

                double diffY = hLine.CenterY - yEsperado; // Distancia hacia abajo del renglón base

                // Una línea de continuación válida se sitúa inmediatamente abajo en paralelo (0.4x a 2.5x el alto de línea)
                if (diffY > (prod.LinePadre.Height * 0.4) && diffY < (prod.LinePadre.Height * 2.5))
                {
                    double distAlRenglonTeorico = Math.Abs(diffY - prod.LinePadre.Height);
                    if (distAlRenglonTeorico < minDeviacionContinuacion)
                    {
                        minDeviacionContinuacion = distAlRenglonTeorico;
                        prodPadre = prod;
                    }
                }
            }

            if (prodPadre != null)
            {
                // Se fusiona el código/texto roto manteniendo la cantidad intacta
                prodPadre.Nombre = (prodPadre.Nombre + " " + hLine.Texto).Trim();
                hLine.Procesado = true;
            }
            else
            {
                // Si es un código de artículo suelto sin cantidad vinculable, se añade con cantidad 1 por seguridad
                if (hLine.Texto.Length > 2)
                {
                    listaEnConstruccion.Add(new ProductoEnConstruccion {
                        Cantidad = 1,
                        Nombre = hLine.Texto,
                        LinePadre = hLine
                    });
                }
            }
        }

        // 6. VOLCADO FINAL A LA INTERFAZ ORDENADO DE ARRIBA A ABAJO
        foreach (var p in listaEnConstruccion.OrderBy(p => p.LinePadre.Top))
        {
            string nombreLimpio = System.Text.RegularExpressions.Regex.Replace(p.Nombre, @"[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\-®]", "").Trim();
            if (nombreLimpio.Length < 3) continue;

            productosDetectados.Add(new Producto {
                Nombre = nombreLimpio,
                Cantidad = p.Cantidad,
                Codigo = "OCR-" + DateTime.Now.ToString("mmssfff")
            });
        }
    }

    // Calcula la distancia vertical exacta de un punto cualquiera a la trayectoria inclinada de un texto
    private double CalcularDesviacionRenglon(RawLine lineaTexto, double targetX, double targetY)
    {
        if (lineaTexto.TieneTrayectoria)
        {
            double yEsperado = lineaTexto.Y0 + lineaTexto.Slope * (targetX - lineaTexto.X0);
            return Math.Abs(targetY - yEsperado);
        }
        return Math.Abs(lineaTexto.CenterY - targetY);
    }
    #endif

    private async Task ProcesarTodo()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Guardando...";
            StateHasChanged();

            foreach (var prod in productosDetectados)
                await DB.GuardarProducto(prod);

            string path = GeneradorPdf.GenerarEtiquetas(productosDetectados);
            await Launcher.Default.OpenAsync(new OpenFileRequest {
                Title = "PDF de Etiquetas",
                File = new ReadOnlyFile(path)
            });

            LimpiarEscaneo();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void LimpiarEscaneo() => productosDetectados.Clear();

#if ANDROID
    public class OnSuccessImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnSuccessListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnSuccessImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnSuccess(Java.Lang.Object result) => _tcs.SetResult(result);
    }

    public class OnFailureImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnFailureListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnFailureImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnFailure(Java.Lang.Exception e) => _tcs.SetException(e);
    }
#endif
}