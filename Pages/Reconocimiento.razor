@page "/reconocimiento"
@using EtiquetadoAuto.Models
@using EtiquetadoAuto.Services
@using Microsoft.Maui.Media
@using Microsoft.JSInterop
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@inject DatabaseService DB
@inject PdfService GeneradorPdf

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0"><i class="oi oi-camera"></i> Escaneo de Albarán</h4>
        </div>
        <div class="card-body text-center">
            <p class="text-secondary">Tome la foto libremente. El sistema unirá las líneas rotas por proximidad.</p>
            
            @if (isProcessing)
            {
                <div class="my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 fw-bold text-primary">@estadoMensaje</p>
                </div>
            }
            else
            {
                <button class="btn btn-success btn-lg w-100 py-3 shadow-sm mb-4" @onclick="CapturarAlbaran">
                    <i class="oi oi-camera"></i> ESCANEAR AHORA
                </button>
            }

            @if (productosDetectados.Any())
            {
                <div class="text-start">
                    <h5 class="mb-3">Material Identificado (@productosDetectados.Count):</h5>
                    <div class="list-group shadow-sm mb-4">
                        @foreach (var prod in productosDetectados)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="d-block fw-bold">@prod.Nombre</span>
                                    <small class="text-muted">Ref: @prod.Codigo</small>
                                </div>
                                <span class="badge bg-primary rounded-pill px-3 py-2">Cant: @prod.Cantidad</span>
                            </div>
                        }
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg shadow" @onclick="ProcesarTodo">
                            <i class="oi oi-check"></i> CONFIRMAR E IMPRIMIR
                        </button>
                        <button class="btn btn-light btn-sm text-danger" @onclick="LimpiarEscaneo">
                            Borrar todo y repetir
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Estructura limpia para el análisis de proximidad sin coordenadas globales distorsionadas
    public class RawLine 
    {
        public string Texto { get; set; } = "";
        public int Top { get; set; }
        public int Bottom { get; set; }
        public int Left { get; set; }
        public int CenterY => (Top + Bottom) / 2;
        public bool Procesado { get; set; } = false;
    }

    // Modelo temporal para reconstruir los productos fila por fila
    public class ProductoEnConstruccion
    {
        public int Cantidad { get; set; }
        public string Nombre { get; set; } = "";
        public int Top { get; set; }
        public int Bottom { get; set; }
        public int CenterY { get; set; }
    }

    private List<Producto> productosDetectados = new();
    private bool isProcessing = false;
    private string estadoMensaje = "";

    private async Task CapturarAlbaran()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Iniciando cámara...";
            StateHasChanged(); 

            var photo = await MediaPicker.CapturePhotoAsync();
            if (photo == null) return;

            estadoMensaje = "Procesando filas de material...";
            StateHasChanged(); 

            #if ANDROID
            var javaFile = new Java.IO.File(photo.FullPath);
            var imageUri = Android.Net.Uri.FromFile(javaFile);
            var image = Xamarin.Google.MLKit.Vision.Common.InputImage.FromFilePath(Android.App.Application.Context, imageUri);
            
            var options = Xamarin.Google.MLKit.Vision.Text.Latin.TextRecognizerOptions.DefaultOptions;
            var recognizer = Xamarin.Google.MLKit.Vision.Text.TextRecognition.GetClient(options);
            
            var tcs = new TaskCompletionSource<object>();
            recognizer.Process(image)
                .AddOnSuccessListener(new OnSuccessImplementation(tcs))
                .AddOnFailureListener(new OnFailureImplementation(tcs));

            var resultObj = await tcs.Task;
            var visionText = (Xamarin.Google.MLKit.Vision.Text.Text)resultObj;
            
            ProcesarTextoLocal(visionText);
            #else
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidad disponible en Android.");
            #endif
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    #if ANDROID
    private void ProcesarTextoLocal(Xamarin.Google.MLKit.Vision.Text.Text visionText)
    {
        productosDetectados.Clear();
        var todasLasLineas = new List<RawLine>();

        // 1. Extraer todas las líneas detectadas por la cámara filtrando la basura obvia
        foreach (var block in visionText.TextBlocks)
        {
            foreach (var line in block.Lines)
            {
                string txt = line.Text.Trim();
                if (string.IsNullOrEmpty(txt)) continue;

                string minus = txt.ToLower()
                    .Replace("à", "a").Replace("á", "a").Replace("è", "e").Replace("é", "e")
                    .Replace("í", "i").Replace("ò", "o").Replace("ó", "o").Replace("ú", "u");

                // Filtro directo de cabeceras, empresas y datos de control
                if (minus.Contains("albara") || minus.Contains("seditesa") || minus.Contains("sintesis") ||
                    minus.Contains("www") || minus.Contains("@") || minus.Contains(".com") ||
                    minus.Contains("izan") || minus.Contains("lecina") || minus.Contains("carrer") ||
                    minus.Contains("telf") || minus.Contains("telefon") || minus.Contains("fecha") || minus.Contains("data") ||
                    minus.Contains("quantitat") || minus.Contains("descripci") || minus.Contains("nro") || minus.Contains("comanda") ||
                    minus.Contains("pag.") || minus.Contains("pagina") || minus.Contains("cliente"))
                {
                    continue;
                }

                todasLasLineas.Add(new RawLine {
                    Texto = txt,
                    Top = line.BoundingBox.Top,
                    Bottom = line.BoundingBox.Bottom,
                    Left = line.BoundingBox.Left
                });
            }
        }

        if (!todasLasLineas.Any()) return;

        // Listas de clasificación para el motor de proximidad
        var lineasCombinadas = new List<RawLine>();  // Ej: "3 Purgadores de vapor" o "Filtro 2"
        var lineasCantidadSolo = new List<RawLine>(); // Ej: "3" (Columna separada)
        var lineasTextoSolo = new List<RawLine>();    // Ej: "Purgadores de vapor"

        // 2. CLASIFICACIÓN DE LÍNEAS MEDIANTE PATRONES
        foreach (var line in todasLasLineas)
        {
            string txt = line.Texto;
            var mIzq = System.Text.RegularExpressions.Regex.Match(txt, @"^(\d{1,3})\s+(.+)$");
            var mDer = System.Text.RegularExpressions.Regex.Match(txt, @"^(.+)\s+(\d{1,3})$");
            var mSoloNum = System.Text.RegularExpressions.Regex.Match(txt, @"^\d{1,3}$");

            if (mSoloNum.Success)
            {
                lineasCantidadSolo.Add(line);
            }
            else if (mIzq.Success || mDer.Success)
            {
                lineasCombinadas.Add(line);
            }
            else
            {
                // Solo guardamos si contiene letras reales para evitar ruidos o símbolos sueltos
                if (txt.Count(char.IsLetter) >= 2)
                {
                    lineasTextoSolo.Add(line);
                }
            }
        }

        var listaEnConstruccion = new List<ProductoEnConstruccion>();

        // 3. PROCESAR LÍNEAS COMBINADAS (Ya traen su número incorporado)
        foreach (var line in lineasCombinadas)
        {
            string txt = line.Texto;
            var mIzq = System.Text.RegularExpressions.Regex.Match(txt, @"^(\d{1,3})\s+(.+)$");
            var mDer = System.Text.RegularExpressions.Regex.Match(txt, @"^(.+)\s+(\d{1,3})$");

            int cant = 1;
            string nombre = txt;

            if (mIzq.Success)
            {
                cant = int.Parse(mIzq.Groups[1].Value);
                nombre = mIzq.Groups[2].Value;
            }
            else if (mDer.Success)
            {
                cant = int.Parse(mDer.Groups[2].Value);
                nombre = mDer.Groups[1].Value;
            }

            listaEnConstruccion.Add(new ProductoEnConstruccion {
                Cantidad = cant,
                Nombre = nombre,
                Top = line.Top,
                Bottom = line.Bottom,
                CenterY = line.CenterY
            });
        }

        // 4. EMPAREJAR CANTIDADES SUELTAS CON SU TEXTO MÁS CERCANO (Mitiga el giro de la foto)
        foreach (var qLine in lineasCantidadSolo)
        {
            RawLine mejorMatchTexto = null;
            double minDistanciaY = double.MaxValue;

            // Buscamos el bloque de texto libre que esté más alineado verticalmente con este número
            foreach (var tLine in lineasTextoSolo.Where(t => !t.Procesado))
            {
                double distY = Math.Abs(qLine.CenterY - tLine.CenterY);
                
                // Un margen tolerante de 60 píxeles absorbe inclinaciones severas entre columnas
                if (distY < 60 && distY < minDistanciaY)
                {
                    minDistanciaY = distY;
                    mejorMatchTexto = tLine;
                }
            }

            if (mejorMatchTexto != null)
            {
                mejorMatchTexto.Procesado = true;
                listaEnConstruccion.Add(new ProductoEnConstruccion {
                    Cantidad = int.Parse(qLine.Texto),
                    Nombre = mejorMatchTexto.Texto,
                    Top = Math.Min(qLine.Top, mejorMatchTexto.Top),
                    Bottom = Math.Max(qLine.Bottom, mejorMatchTexto.Bottom),
                    CenterY = (qLine.CenterY + mejorMatchTexto.CenterY) / 2
                });
            }
        }

        // 5. CAPTURAR LÍNEAS HUÉRFANAS (Textos partidos que perdieron el número por el giro)
        var huerfanasOrdenadas = lineasTextoSolo.Where(t => !t.Procesado).OrderBy(t => t.CenterY).ToList();

        foreach (var hLine in huerfanasOrdenadas)
        {
            ProductoEnConstruccion productoArriba = null;
            double minDiffY = double.MaxValue;

            // Buscamos el artículo que esté inmediatamente por encima de esta línea huérfana
            foreach (var prod in listaEnConstruccion)
            {
                double diffY = hLine.CenterY - prod.CenterY;
                
                // Si está abajo (diffY > 0) y a una distancia coherente de renglón continuo
                if (diffY > 0 && diffY < 65 && diffY < minDiffY)
                {
                    minDiffY = diffY;
                    productoArriba = prod;
                }
            }

            if (productoArriba != null)
            {
                // ¡Anexamos el texto partido al artículo padre conservando su cantidad intacta!
                productoArriba.Nombre = (productoArriba.Nombre + " " + hLine.Texto).Trim();
                productoArriba.Bottom = hLine.Bottom;
                productoArriba.CenterY = (productoArriba.Top + hLine.Bottom) / 2;
            }
            else
            {
                // Si la línea de texto está completamente sola y aislada, no la descartamos: 
                // la registramos con cantidad 1 para asegurar la revisión del operario
                listaEnConstruccion.Add(new ProductoEnConstruccion {
                    Cantidad = 1,
                    Nombre = hLine.Texto,
                    Top = hLine.Top,
                    Bottom = hLine.Bottom,
                    CenterY = hLine.CenterY
                });
            }
        }

        // 6. LIMPIEZA FINAL Y CARGA EN LA UI (Ordenados de arriba a abajo del papel)
        foreach (var p in listaEnConstruccion.OrderBy(p => p.Top))
        {
            // Remover caracteres extraños manteniendo texto limpio
            string nombreLimpio = System.Text.RegularExpressions.Regex.Replace(p.Nombre, @"[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\-®]", "").Trim();
            
            // Filtro de seguridad: Un artículo real debe poseer contenido de texto representativo
            if (nombreLimpio.Count(char.IsLetter) < 4) continue;

            productosDetectados.Add(new Producto {
                Nombre = nombreLimpio,
                Cantidad = p.Cantidad,
                Codigo = "OCR-" + DateTime.Now.ToString("mmssfff")
            });
        }
    }
    #endif

    private async Task ProcesarTodo()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Guardando...";
            StateHasChanged();

            foreach (var prod in productosDetectados)
                await DB.GuardarProducto(prod);

            string path = GeneradorPdf.GenerarEtiquetas(productosDetectados);
            await Launcher.Default.OpenAsync(new OpenFileRequest {
                Title = "PDF de Etiquetas",
                File = new ReadOnlyFile(path)
            });

            LimpiarEscaneo();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void LimpiarEscaneo() => productosDetectados.Clear();

#if ANDROID
    public class OnSuccessImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnSuccessListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnSuccessImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnSuccess(Java.Lang.Object result) => _tcs.SetResult(result);
    }

    public class OnFailureImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnFailureListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnFailureImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnFailure(Java.Lang.Exception e) => _tcs.SetException(e);
    }
#endif
}