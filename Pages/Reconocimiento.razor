@page "/reconocimiento"
@using EtiquetadoAuto.Models
@using EtiquetadoAuto.Services
@using Microsoft.Maui.Media
@using Microsoft.JSInterop
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@inject DatabaseService DB
@inject PdfService GeneradorPdf

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0"><i class="oi oi-camera"></i> Escaneo de Albarán</h4>
        </div>
        <div class="card-body text-center">
            <p class="text-secondary">Alinee bien la cámara. El sistema separará estrictamente cada artículo.</p>
            
            @if (isProcessing)
            {
                <div class="my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 fw-bold text-primary">@estadoMensaje</p>
                </div>
            }
            else
            {
                <button class="btn btn-success btn-lg w-100 py-3 shadow-sm mb-4" @onclick="CapturarAlbaran">
                    <i class="oi oi-camera"></i> ESCANEAR AHORA
                </button>
            }

            @if (productosDetectados.Any())
            {
                <div class="text-start">
                    <h5 class="mb-3">Material Identificado (@productosDetectados.Count):</h5>
                    <div class="list-group shadow-sm mb-4">
                        @foreach (var prod in productosDetectados)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="d-block fw-bold">@prod.Nombre</span>
                                    <small class="text-muted">Ref: @prod.Codigo</small>
                                </div>
                                <span class="badge bg-primary rounded-pill px-3 py-2">Cant: @prod.Cantidad</span>
                            </div>
                        }
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg shadow" @onclick="ProcesarTodo">
                            <i class="oi oi-check"></i> CONFIRMAR E IMPRIMIR
                        </button>
                        <button class="btn btn-light btn-sm text-danger" @onclick="LimpiarEscaneo">
                            Borrar todo y repetir
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Estructura de coordenadas avanzada utilizando el rectángulo nativo
    public class InfoLinea 
    {
        public string Texto { get; set; } = "";
        public int Top { get; set; }
        public int Bottom { get; set; }
        public int Left { get; set; }
        public int Right { get; set; }
        public int Height { get; set; }
        public int CenterY => (Top + Bottom) / 2;
    }

    private List<Producto> productosDetectados = new();
    private bool isProcessing = false;
    private string estadoMensaje = "";

    private async Task CapturarAlbaran()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Iniciando cámara...";
            StateHasChanged(); 

            var photo = await MediaPicker.CapturePhotoAsync();
            if (photo == null) return;

            estadoMensaje = "Analizando texto...";
            StateHasChanged(); 

            #if ANDROID
            var javaFile = new Java.IO.File(photo.FullPath);
            var imageUri = Android.Net.Uri.FromFile(javaFile);
            var image = Xamarin.Google.MLKit.Vision.Common.InputImage.FromFilePath(Android.App.Application.Context, imageUri);
            
            var options = Xamarin.Google.MLKit.Vision.Text.Latin.TextRecognizerOptions.DefaultOptions;
            var recognizer = Xamarin.Google.MLKit.Vision.Text.TextRecognition.GetClient(options);
            
            var tcs = new TaskCompletionSource<object>();
            recognizer.Process(image)
                .AddOnSuccessListener(new OnSuccessImplementation(tcs))
                .AddOnFailureListener(new OnFailureImplementation(tcs));

            var resultObj = await tcs.Task;
            var visionText = (Xamarin.Google.MLKit.Vision.Text.Text)resultObj;
            
            ProcesarTextoMejorado(visionText);
            #else
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidad disponible en Android.");
            #endif
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    #if ANDROID
    private void ProcesarTextoMejorado(Xamarin.Google.MLKit.Vision.Text.Text visionText)
    {
        productosDetectados.Clear();
        var todasLasLineas = new List<InfoLinea>();

        // 1. Extraer todas las líneas con sus cajas delimitadoras (Rect)
        foreach (var block in visionText.TextBlocks)
        {
            foreach (var line in block.Lines)
            {
                todasLasLineas.Add(new InfoLinea { 
                    Texto = line.Text.Trim(), 
                    Top = line.BoundingBox.Top,
                    Bottom = line.BoundingBox.Bottom,
                    Left = line.BoundingBox.Left,
                    Right = line.BoundingBox.Right,
                    Height = line.BoundingBox.Height()
                });
            }
        }

        if (!todasLasLineas.Any()) return;

        // 2. AGRUPACIÓN ANTICOLISIONES: Agrupar en filas reales de tabla
        var ordenadasPorTop = todasLasLineas.OrderBy(l => l.Top).ToList();
        var filas = new List<List<InfoLinea>>();

        foreach (var linea in ordenadasPorTop)
        {
            bool asignada = false;
            foreach (var fila in filas)
            {
                double centroFila = fila.Average(l => l.CenterY);
                
                // Si la distancia vertical es pequeña (tolerancia para inclinación de foto)
                if (Math.Abs(linea.CenterY - centroFila) < 22)
                {
                    // REGLA DE ORO: Si se solapan horizontalmente en el eje X, significa que 
                    // un texto está encima de otro. Por tanto, NO pueden ser la misma fila.
                    bool solapeHorizontal = fila.Any(l => !(linea.Right < l.Left || linea.Left > l.Right));

                    if (!solapeHorizontal)
                    {
                        fila.Add(linea);
                        asignada = true;
                        break;
                    }
                }
            }

            if (!asignada)
            {
                filas.Add(new List<InfoLinea> { linea });
            }
        }

        // 3. PROCESAR CADA FILA DE FORMA TOTALMENTE INDEPENDIENTE
        foreach (var fila in filas)
        {
            // Ordenar de izquierda a derecha (lectura natural de columnas)
            var itemsFila = fila.OrderBy(f => f.Left).ToList();
            string textoCompletoFila = string.Join(" ", itemsFila.Select(f => f.Texto));
            
            string minus = textoCompletoFila.ToLower()
                .Replace("à", "a").Replace("á", "a").Replace("è", "e").Replace("é", "e")
                .Replace("í", "i").Replace("ò", "o").Replace("ó", "o").Replace("ú", "u");

            // Filtro estricto de textos de cabecera y datos de empresa
            if (minus.Contains("albara") || minus.Contains("seditesa") || minus.Contains("sintesis") ||
                minus.Contains("www") || minus.Contains("@") || minus.Contains(".com") || minus.Contains(".org") ||
                minus.Contains("izan") || minus.Contains("lecina") || minus.Contains("carrer") || minus.Contains("carer") ||
                minus.Contains("telf") || minus.Contains("telefon") || minus.Contains("fecha") || minus.Contains("data") ||
                minus.Contains("quantitat") || minus.Contains("descripci") || minus.Contains("nro") || minus.Contains("comanda") ||
                minus.Contains("numero de serie") || minus.Contains("numero de srie") || minus.Contains("pag.") || minus.Contains("pagina"))
            {
                continue;
            }

            int cant = 0;
            string nombre = "";

            // Extracción inteligente analizando los extremos de la fila (Columnas habituales de cantidad)
            string primerTexto = itemsFila[0].Texto.Trim();
            var matchSoloNumeroPri = System.Text.RegularExpressions.Regex.Match(primerTexto, @"^\d{1,3}$");
            var matchCombinadoPri = System.Text.RegularExpressions.Regex.Match(primerTexto, @"^(\d{1,3})\s+(.+)$");

            if (matchSoloNumeroPri.Success)
            {
                cant = int.Parse(primerTexto);
                nombre = string.Join(" ", itemsFila.Skip(1).Select(f => f.Texto));
            }
            else if (matchCombinadoPri.Success)
            {
                cant = int.Parse(matchCombinadoPri.Groups[1].Value);
                nombre = matchCombinadoPri.Groups[2].Value + " " + string.Join(" ", itemsFila.Skip(1).Select(f => f.Texto));
            }
            else
            {
                // Si no está a la izquierda, probamos si la cantidad está en la columna de la derecha (último bloque)
                string ultimoTexto = itemsFila[itemsFila.Count - 1].Texto.Trim();
                var matchSoloNumeroUlt = System.Text.RegularExpressions.Regex.Match(ultimoTexto, @"^\d{1,3}$");
                var matchCombinadoUlt = System.Text.RegularExpressions.Regex.Match(ultimoTexto, @"^(.+)\s+(\d{1,3})$");

                if (matchSoloNumeroUlt.Success && itemsFila.Count > 1)
                {
                    cant = int.Parse(ultimoTexto);
                    nombre = string.Join(" ", itemsFila.Take(itemsFila.Count - 1).Select(f => f.Texto));
                }
                else if (matchCombinadoUlt.Success)
                {
                    cant = int.Parse(matchCombinadoUlt.Groups[2].Value);
                    nombre = string.Join(" ", itemsFila.Take(itemsFila.Count - 1).Select(f => f.Texto)) + " " + matchCombinadoUlt.Groups[1].Value;
                }
                else
                {
                    // Si el número está flotando por el medio, unimos todo y buscamos un patrón numérico inicial
                    nombre = string.Join(" ", itemsFila.Select(f => f.Texto));
                    foreach (var item in itemsFila)
                    {
                        var m = System.Text.RegularExpressions.Regex.Match(item.Texto.Trim(), @"^(\d{1,3})\b");
                        if (m.Success)
                        {
                            cant = int.Parse(m.Groups[1].Value);
                            break;
                        }
                    }
                }
            }

            // Si tras analizar no se encuentra cantidad, ponemos 1 por defecto para no perder jamás el artículo
            if (cant == 0) cant = 1;

            // Limpieza de caracteres extraños en el nombre
            nombre = System.Text.RegularExpressions.Regex.Replace(nombre, @"[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\-®]", "").Trim();

            // --- FILTRO DEFINITIVO ANTI-TELÉFONOS Y CÓDIGOS ---
            // Un producto real debe tener letras. Contamos los caracteres alfabéticos.
            int totalLetras = nombre.Count(char.IsLetter);
            if (totalLetras < 4)
            {
                // Si la línea son solo números (un teléfono suelto, código postal o número de albarán), se descarta automáticamente
                continue;
            }

            // Guardar el producto limpio
            productosDetectados.Add(new Producto {
                Nombre = nombre,
                Cantidad = cant,
                Codigo = "OCR-" + DateTime.Now.ToString("mmssfff")
            });
        }
    }
    #endif

    private async Task ProcesarTodo()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Guardando...";
            StateHasChanged();

            foreach (var prod in productosDetectados)
                await DB.GuardarProducto(prod);

            string path = GeneradorPdf.GenerarEtiquetas(productosDetectados);
            await Launcher.Default.OpenAsync(new OpenFileRequest {
                Title = "PDF de Etiquetas",
                File = new ReadOnlyFile(path)
            });

            LimpiarEscaneo();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void LimpiarEscaneo() => productosDetectados.Clear();

#if ANDROID
    public class OnSuccessImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnSuccessListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnSuccessImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnSuccess(Java.Lang.Object result) => _tcs.SetResult(result);
    }

    public class OnFailureImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnFailureListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnFailureImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnFailure(Java.Lang.Exception e) => _tcs.SetException(e);
    }
#endif
}