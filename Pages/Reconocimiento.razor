@page "/reconocimiento"
@using EtiquetadoAuto.Models
@using EtiquetadoAuto.Services
@using Microsoft.Maui.Media
@using Microsoft.JSInterop
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@inject DatabaseService DB
@inject PdfService GeneradorPdf

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0"><i class="oi oi-camera"></i> Escaneo de Albarán</h4>
        </div>
        <div class="card-body text-center">
            <p class="text-secondary">Ajusta las cantidades y las dimensiones de la etiqueta antes de generar el PDF.</p>
            
            @if (isProcessing)
            {
                <div class="my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 fw-bold text-primary">@estadoMensaje</p>
                </div>
            }
            else
            {
                <button class="btn btn-success btn-lg w-100 py-3 shadow-sm mb-4" @onclick="CapturarAlbaran">
                    <i class="oi oi-camera"></i> ESCANEAR AHORA
                </button>
            }

            @if (productosDetectados.Any())
            {
                <div class="text-start">
                    <h5 class="mb-3">Material Identificado (@productosDetectados.Count):</h5>
                    <div class="list-group shadow-sm mb-4">
                        @foreach (var prod in productosDetectados)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="me-3" style="flex: 1;">
                                    <span class="d-block fw-bold @(prod.Cantidad == 0 ? "text-danger" : "")">@prod.Nombre</span>
                                    <small class="text-muted">Ref: @prod.Codigo</small>
                                </div>
                                
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-light btn-sm border text-danger fw-bold px-3 py-1 shadow-sm" @onclick="() => DisminuirCantidad(prod)">-</button>
                                    <span class="badge @(prod.Cantidad == 0 ? "bg-warning text-dark" : "bg-primary") rounded-pill mx-2 px-3 py-2" style="font-size: 1rem; min-width: 45px;">
                                        @prod.Cantidad
                                    </span>
                                    <button class="btn btn-light btn-sm border text-success fw-bold px-3 py-1 shadow-sm" @onclick="() => AumentarCantidad(prod)">+</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card bg-light border-0 mb-4 p-3 shadow-sm">
                        <h6 class="fw-bold mb-3 text-dark"><i class="oi oi-wrench"></i> Configuración del Tamaño (mm)</h6>
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">Tamaños Rápidos</label>
                                <select class="form-select form-select-sm" @onchange="OnChangePresetTamaño">
                                    <option value="estandar">Estándar (80mm x 50mm)</option>
                                    <option value="pequena">Pequeña (50mm x 30mm)</option>
                                    <option value="grande">Grande (100mm x 70mm)</option>
                                    <option value="manual">Personalizado...</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Ancho (mm)</label>
                                <input type="number" class="form-control form-control-sm" @bind="etiquetaAnchoMm" min="10" max="300" disabled="@(presetSeleccionado != "manual")" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Alto (mm)</label>
                                <input type="number" class="form-control form-control-sm" @bind="etiquetaAltoMm" min="10" max="300" disabled="@(presetSeleccionado != "manual")" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg shadow" @onclick="ProcesarTodo">
                            <i class="oi oi-check"></i> CONFIRMAR E IMPRIMIR
                        </button>
                        <button class="btn btn-light btn-sm text-danger" @onclick="LimpiarEscaneo">
                            Borrar todo y repetir
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Variables de control para las dimensiones
    private double etiquetaAnchoMm = 80;
    private double etiquetaAltoMm = 50;
    private string presetSeleccionado = "estandar";

    private void OnChangePresetTamaño(ChangeEventArgs e)
    {
        presetSeleccionado = e.Value?.ToString() ?? "estandar";
        if (presetSeleccionado == "estandar") { etiquetaAnchoMm = 80; etiquetaAltoMm = 50; }
        else if (presetSeleccionado == "pequena") { etiquetaAnchoMm = 50; etiquetaAltoMm = 30; }
        else if (presetSeleccionado == "grande") { etiquetaAnchoMm = 100; etiquetaAltoMm = 70; }
    }

    public class RawLine 
    {
        public string Texto { get; set; } = "";
        public int Top { get; set; }
        public int Bottom { get; set; }
        public int Left { get; set; }
        public int Right { get; set; }
        public int Height => Bottom - Top;
        public double CenterX => (Left + Right) / 2.0;
        public double CenterY => (Top + Bottom) / 2.0;
        public double X0 { get; set; }
        public double Y0 { get; set; }
        public double Slope { get; set; }
        public bool TieneTrayectoria { get; set; } = false;
    }

    public class RowItem
    {
        public int Cantidad { get; set; } = 0; 
        public string TextoCompleto { get; set; } = "";
        public bool TieneCantidadExplicita { get; set; } = false;
        public double AverageY { get; set; }
        public double Height { get; set; }
    }

    private List<Producto> productosDetectados = new();
    private bool isProcessing = false;
    private string estadoMensaje = "";

    private void AumentarCantidad(Producto p) => p.Cantidad++;
    private void DisminuirCantidad(Producto p) { if (p.Cantidad > 0) p.Cantidad--; }

    private async Task CapturarAlbaran()
    {
        try
        {
            isProcessing = true;
            estadoMensaje = "Abriendo cámara...";
            StateHasChanged(); 

            var photo = await MediaPicker.CapturePhotoAsync();
            if (photo == null) return;

            estadoMensaje = "Procesando matriz de texto...";
            StateHasChanged(); 

            #if ANDROID
            var javaFile = new Java.IO.File(photo.FullPath);
            var imageUri = Android.Net.Uri.FromFile(javaFile);
            var image = Xamarin.Google.MLKit.Vision.Common.InputImage.FromFilePath(Android.App.Application.Context, imageUri);
            
            var options = Xamarin.Google.MLKit.Vision.Text.Latin.TextRecognizerOptions.DefaultOptions;
            var recognizer = Xamarin.Google.MLKit.Vision.Text.TextRecognition.GetClient(options);
            
            var tcs = new TaskCompletionSource<object>();
            recognizer.Process(image)
                .AddOnSuccessListener(new OnSuccessImplementation(tcs))
                .AddOnFailureListener(new OnFailureImplementation(tcs));

            var resultObj = await tcs.Task;
            var visionText = (Xamarin.Google.MLKit.Vision.Text.Text)resultObj;
            
            ProcesarConMatrizHorizontal(visionText);
            #else
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidad disponible en Android.");
            #endif
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    #if ANDROID
    private void ProcesarConMatrizHorizontal(Xamarin.Google.MLKit.Vision.Text.Text visionText)
    {
        productosDetectados.Clear();
        var todasLasLineas = new List<RawLine>();

        foreach (var block in visionText.TextBlocks)
        {
            foreach (var line in block.Lines)
            {
                string txt = line.Text.Trim();
                if (string.IsNullOrEmpty(txt)) continue;

                string minus = txt.ToLower()
                    .Replace("à", "a").Replace("á", "a").Replace("è", "e").Replace("é", "e")
                    .Replace("í", "i").Replace("ò", "o").Replace("ó", "o").Replace("ú", "u")
                    .Replace("ç", "c");

                if (minus.Contains("telf") || minus.Contains("telefon") || minus.Contains("tel.") ||
                    minus.Contains("direccio") || minus.Contains("carrer") || minus.Contains("c/ ") ||
                    minus.Contains("cognom") || minus.Contains("nom i") || minus.Contains("Teleforn") || 
                    minus.Contains("alliarm") || minus.Contains("albaran") || minus.Contains("albara") || minus.Contains("alberan") ||
                    minus.Contains("comanda") || minus.Contains("pedido") || minus.Contains("carer") ||
                    minus.Contains("fecha") || minus.Contains("data") || minus.Contains("Número") ||
                    minus.Contains("pagina") || minus.Contains("pag.") || minus.Contains("www") ||
                    minus.Contains("cliente") || minus.Contains("proveedor") ||
                    minus.Contains("seditesa") || minus.Contains("srie") || 
                    minus.Contains("nif:") || minus.Contains("cif:"))
                {
                    continue; 
                }

                txt = System.Text.RegularExpressions.Regex.Replace(txt, @"(?i)\b(quantitat|descripcio|descripció|descripción|cantidad|articulo|artículo|codigo|código|cant|ref)\b", "").Trim();
                
                if (string.IsNullOrEmpty(txt)) continue;

                var box = line.BoundingBox;
                if (box == null) continue;

                var corners = line.GetCornerPoints();
                double x0 = box.Left;
                double y0 = box.Top;
                double slope = 0;
                bool tieneTrayectoria = false;

                if (corners != null && corners.Length >= 2)
                {
                    double dx = corners[1].X - corners[0].X;
                    double dy = corners[1].Y - corners[0].Y;
                    if (Math.Abs(dx) > 10)
                    {
                        x0 = corners[0].X;
                        y0 = corners[0].Y;
                        slope = dy / dx;
                        tieneTrayectoria = true;
                    }
                }

                todasLasLineas.Add(new RawLine {
                    Texto = txt,
                    Top = box.Top,
                    Bottom = box.Bottom,
                    Left = box.Left,
                    Right = box.Right,
                    X0 = x0,
                    Y0 = y0,
                    Slope = slope,
                    TieneTrayectoria = tieneTrayectoria
                });
            }
        }

        if (!todasLasLineas.Any()) return;

        var filasHorizontales = new List<List<RawLine>>();
        var lineasPorProcesar = todasLasLineas.OrderBy(l => l.Left).ToList();

        while (lineasPorProcesar.Any())
        {
            var baseLine = lineasPorProcesar.First();
            lineasPorProcesar.Remove(baseLine);

            var filaActual = new List<RawLine> { baseLine };

            for (int i = lineasPorProcesar.Count - 1; i >= 0; i--)
            {
                var target = lineasPorProcesar[i];
                double yTeorico = baseLine.TieneTrayectoria 
                    ? baseLine.Y0 + baseLine.Slope * (target.CenterX - baseLine.X0)
                    : baseLine.CenterY;

                if (Math.Abs(target.CenterY - yTeorico) < (baseLine.Height * 0.75))
                {
                    filaActual.Add(target);
                    lineasPorProcesar.RemoveAt(i);
                }
            }
            filasHorizontales.Add(filaActual);
        }

        var filasOrdenadas = filasHorizontales.OrderBy(f => f.Average(l => l.CenterY)).ToList();
        var listaRowItems = new List<RowItem>();

        foreach (var fila in filasOrdenadas)
        {
            var piezasIzquierdaDerecha = fila.OrderBy(l => l.Left).ToList();
            
            int cantFila = 0; 
            bool tieneCant = false;
            var palabrasTexto = new List<string>();

            foreach (var pieza in piezasIzquierdaDerecha)
            {
                string t = pieza.Texto.Trim();
                if (string.IsNullOrEmpty(t)) continue;

                var mSoloNum = System.Text.RegularExpressions.Regex.Match(t, @"^(\d{1,3})(?:[,.]\d{1,2})?(?:\s*(?:ud|uds|pz|pzs|u))?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

                if (mSoloNum.Success && !tieneCant)
                {
                    cantFila = int.Parse(mSoloNum.Groups[1].Value);
                    tieneCant = true;
                }
                else
                {
                    palabrasTexto.Add(t);
                }
            }

            string textoUnido = string.Join(" ", palabrasTexto).Trim();

            if (!tieneCant)
            {
                var mIzq = System.Text.RegularExpressions.Regex.Match(textoUnido, @"^(\d{1,3})(?:[,.]\d{1,2})?(?:\s*(?:ud|uds|pz|pzs|u))?\s+(.+)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (mIzq.Success)
                {
                    cantFila = int.Parse(mIzq.Groups[1].Value);
                    textoUnido = mIzq.Groups[2].Value;
                    tieneCant = true;
                }
            }

            textoUnido = System.Text.RegularExpressions.Regex.Replace(textoUnido, @"\s+", " ").Trim();

            if (!string.IsNullOrEmpty(textoUnido))
            {
                listaRowItems.Add(new RowItem {
                    Cantidad = cantFila,
                    TextoCompleto = textoUnido,
                    TieneCantidadExplicita = tieneCant,
                    AverageY = fila.Average(l => l.CenterY),
                    Height = fila.Average(l => l.Height)
                });
            }
        }

        var productosPreFormados = new List<RowItem>();

        foreach (var item in listaRowItems)
        {
            if (!item.TieneCantidadExplicita && productosPreFormados.Any())
            {
                var ultimoProd = productosPreFormados.Last();
                double diffY = item.AverageY - ultimoProd.AverageY;

                if (diffY > 0 && diffY < (item.Height * 1.5))
                {
                    ultimoProd.TextoCompleto = (ultimoProd.TextoCompleto + " " + item.TextoCompleto).Trim();
                    ultimoProd.AverageY = item.AverageY; 
                    continue;
                }
            }

            productosPreFormados.Add(item);
        }

        foreach (var p in productosPreFormados)
        {
            string nombreLimpio = p.TextoCompleto.Trim();
            string soloLetras = System.Text.RegularExpressions.Regex.Replace(nombreLimpio, @"[^a-zA-ZáéíóúÁÉÍÓÚñÑ]", "");
            
            if (soloLetras.Length < 4) continue; 

            productosDetectados.Add(new Producto {
                Nombre = nombreLimpio,
                Cantidad = p.Cantidad,
                Codigo = "OCR-" + DateTime.Now.ToString("mmssfff")
            });
        }
    }
    #endif

    private async Task ProcesarTodo()
    {
        try
        {
            var productosParaImprimir = productosDetectados.Where(p => p.Cantidad > 0).ToList();

            if (!productosParaImprimir.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Asigna al menos una cantidad mayor a 0.");
                return;
            }

            isProcessing = true;
            estadoMensaje = "Guardando e imprimiendo...";
            StateHasChanged();

            foreach (var prod in productosParaImprimir)
                await DB.GuardarProducto(prod);

            // MODIFICACIÓN CRUCIAL: Pasamos las variables de ancho y alto elegidas por el usuario en milímetros
            string path = GeneradorPdf.GenerarEtiquetas(productosParaImprimir, etiquetaAnchoMm, etiquetaAltoMm);
            
            await Launcher.Default.OpenAsync(new OpenFileRequest {
                Title = "PDF de Etiquetas",
                File = new ReadOnlyFile(path)
            });

            LimpiarEscaneo();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void LimpiarEscaneo() => productosDetectados.Clear();

#if ANDROID
    public class OnSuccessImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnSuccessListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnSuccessImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnSuccess(Java.Lang.Object result) => _tcs.SetResult(result);
    }

    public class OnFailureImplementation : Java.Lang.Object, Android.Gms.Tasks.IOnFailureListener
    {
        private readonly TaskCompletionSource<object> _tcs;
        public OnFailureImplementation(TaskCompletionSource<object> tcs) => _tcs = tcs;
        public void OnFailure(Java.Lang.Exception e) => _tcs.SetException(e);
    }
#endif
}